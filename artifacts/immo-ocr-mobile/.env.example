# ── IMMO OCR Scanner – environment variables ────────────────────────────────
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app at build time.

# API domain (hostname only, no protocol) for the IMMO FLOW ME backend.
# Example: "api.immo-flow.example.com"
EXPO_PUBLIC_DOMAIN=

# Login request timeout in milliseconds.
# Increase for slow mobile networks (e.g. rural Austria on 3G).
# Default: 10000 (10 seconds)
EXPO_PUBLIC_LOGIN_TIMEOUT_MS=10000
